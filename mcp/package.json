    "react-dom": "^19.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
