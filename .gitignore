# ==========================================
# GENERAL & OS METADATA
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.swp
*.swo

# ==========================================
# IDE & EDITOR FILES
# ==========================================
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ==========================================
# BACKEND (Spring Boot / Java / Maven)
# ==========================================
backend/target/
backend/.mvn/
*.class
*.log
# Exclude local configuration or secret property overrides
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-secret.yml

# ==========================================
# FRONTEND (React / TypeScript / Vite / Node)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# MCP server and bundled MCP App
mcp/node_modules/
mcp/dist/
mcp/.env
mcp/.env.*
!mcp/.env.example
mcp/npm-debug.log*

# ==========================================
# INFRASTRUCTURE & ENVIRONMENT SECRETS
# ==========================================
# Never commit actual environment variable files or keys (Hard Gate 1)
.env
*.pem
*.key
secrets/